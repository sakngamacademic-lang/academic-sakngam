# คัดลอกเป็น .env.local แล้วใส่ค่าของ Supabase "local" หรือ "staging" เท่านั้น
# ห้ามใส่ค่า production และห้ามใส่ service_role key ในไฟล์ฝั่ง frontend
# Phase 1.1 ยังไม่เชื่อมฐานข้อมูล ปล่อยว่างไว้ได้

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ชื่อสภาพแวดล้อมที่แสดงบนแถบสถานะ: local | staging
VITE_APP_ENV=local

# Edge Functions (เว้นว่าง = <VITE_SUPABASE_URL>/functions/v1)
# local ที่รันด้วย `npm run storage:dev` ใช้ http://127.0.0.1:54330/functions/v1
# ⚠️ ห้ามใส่ R2 key ที่นี่ — R2 credentials อยู่ใน Supabase Edge Function Secrets เท่านั้น
VITE_FUNCTIONS_URL=
